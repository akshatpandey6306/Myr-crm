generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING  @map("pending")
  ACTIVE   @map("active")
  DISABLED @map("disabled")

  @@map("user_status")
}

enum OrganizationStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("organization_status")
}

enum SubscriptionStatus {
  PENDING   @map("pending")
  TRIAL     @map("trial")
  ACTIVE    @map("active")
  EXPIRED   @map("expired")
  CANCELLED @map("cancelled")

  @@map("subscription_status")
}

enum ActivationRequestStatus {
  PENDING   @map("pending")
  ACTIVATED @map("activated")
  DECLINED  @map("declined")

  @@map("activation_request_status")
}

enum SubscriptionPaymentType {
  TRIAL
  PLAN
  RENEWAL
}

enum SubscriptionPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SubscriptionRequestType {
  TRIAL      @map("trial")
  ACTIVATION @map("activation")

  @@map("subscription_request_type")
}

enum MembershipRole {
  OWNER         @map("owner")
  ADMIN         @map("admin")
  SALES_MANAGER @map("sales_manager")
  SALES_REP     @map("sales_rep")
  READ_ONLY     @map("read_only")

  @@map("membership_role")
}

enum MembershipStatus {
  PENDING @map("pending")
  ACTIVE  @map("active")
  REVOKED @map("revoked")
  REMOVED @map("removed")

  @@map("membership_status")
}

enum LeadSource {
  WEBSITE  @map("website")
  REFERRAL @map("referral")
  LINKEDIN @map("linkedin")
  OTHER    @map("other")

  @@map("lead_source")
}

enum LeadStatus {
  NEW          @map("new")
  CONTACTED    @map("contacted")
  QUALIFIED    @map("qualified")
  DISQUALIFIED @map("disqualified")

  @@map("lead_status")
}

enum DealStatus {
  OPEN @map("open")
  WON  @map("won")
  LOST @map("lost")

  @@map("deal_status")
}

enum ActivityType {
  TASK    @map("task")
  CALL    @map("call")
  MEETING @map("meeting")
  NOTE    @map("note")
  EMAIL   @map("email")

  @@map("activity_type")
}

enum ActivityStatus {
  OPEN        @map("open")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  CANCELLED   @map("cancelled")

  @@map("activity_status")
}

enum ActivityPriority {
  LOW    @map("low")
  NORMAL @map("normal")
  HIGH   @map("high")

  @@map("activity_priority")
}

enum VendorStatus {
  ACTIVE  @map("active")
  PENDING @map("pending")
  ON_HOLD @map("on_hold")

  @@map("vendor_status")
}

enum BillingInvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum BillingInvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum BillingQuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum BillingCustomerType {
  CONTACT
  COMPANY
  CUSTOM
}

enum BillingPaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
  PAYMENT_GATEWAY
  OTHER
}

enum BillingDiscountType {
  PERCENTAGE
  FIXED
}

enum BillingTaxSystem {
  GENERIC
  INDIA_GST
}

enum RelatedRecordType {
  LEAD    @map("lead")
  CONTACT @map("contact")
  COMPANY @map("company")
  DEAL    @map("deal")

  @@map("related_record_type")
}

enum AutomationTrigger {
  LEAD_CREATED        @map("lead_created")
  LEAD_STATUS_CHANGED @map("lead_status_changed")

  @@map("automation_trigger")
}

enum EmailDeliveryStatus {
  NOT_CONFIGURED @map("not_configured")
  QUEUED         @map("queued")
  SENT           @map("sent")
  FAILED         @map("failed")

  @@map("email_delivery_status")
}

enum NotificationType {
  ACTIVITY_ASSIGNED @map("activity_assigned")
  ACTIVITY_COMPLETED @map("activity_completed")
  MEMBER_JOIN_REQUEST @map("member_join_request")

  @@map("notification_type")
}

enum AuditAction {
  CREATE  @map("create")
  UPDATE  @map("update")
  ARCHIVE @map("archive")

  @@map("audit_action")
}

enum EmailTokenPurpose {
  PASSWORD_RESET     @map("password_reset")
  EMAIL_VERIFICATION @map("email_verification")
  ACCOUNT_ACTIVATION @map("account_activation")

  @@map("email_token_purpose")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique @db.VarChar(254)
  name            String       @db.VarChar(120)
  passwordHash    String       @map("password_hash") @db.VarChar(255)
  status          UserStatus   @default(ACTIVE)
  emailVerifiedAt DateTime?    @map("email_verified_at") @db.Timestamptz(3)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships     Membership[]
  sessions        Session[]
  emailTokens     EmailToken[]
  activationRequests SubscriptionActivationRequest[]

  @@map("users")
}

model Organization {
  id                     String             @id @default(uuid()) @db.Uuid
  joinCode               String             @unique @default(uuid()) @map("join_code") @db.Uuid
  name                   String             @db.VarChar(160)
  slug                   String?            @unique @db.VarChar(63)
  timezone               String             @default("UTC") @db.VarChar(64)
  status                 OrganizationStatus @default(ACTIVE)
  subscriptionPlan       String?            @map("subscription_plan") @db.VarChar(32)
  subscriptionStatus     SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  subscriptionStartedAt  DateTime?          @map("subscription_started_at") @db.Timestamptz(3)
  subscriptionEndsAt     DateTime?          @map("subscription_ends_at") @db.Timestamptz(3)
  billingProvider        String?            @map("billing_provider") @db.VarChar(32)
  razorpaySubscriptionId String?            @map("razorpay_subscription_id") @db.VarChar(128)
  enabledModules         String[]            @default(["leads", "contacts", "companies", "deals", "activities", "vendors", "billing-invoicing", "team", "automation", "email", "reports", "audit-logs", "settings"]) @map("enabled_modules")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships            Membership[]
  workspaceRoles         WorkspaceRole[]
  leads                  Lead[]
  leadCalls              LeadCall[]
  contacts               Contact[]
  companies              Company[]
  vendors                Vendor[]
  pipelines              Pipeline[]
  deals                  Deal[]
  activities             Activity[]
  emailMessages          EmailMessage[]
  automationRules        AutomationRule[]
  automationRuns         AutomationRun[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  settings               OrganizationSettings?
  billingSettings        BillingSettings?
  billingProducts        BillingProduct[]
  billingInvoices        BillingInvoice[]
  billingInvoiceItems    BillingInvoiceItem[]
  billingQuotations      BillingQuotation[]
  billingQuotationItems  BillingQuotationItem[]
  billingPayments        BillingPayment[]
  billingReceipts        BillingReceipt[]
  billingAuditEvents     BillingAuditEvent[]
  subscriptionPayments   SubscriptionPayment[]
  subscriptionPlanOverrides OrganizationSubscriptionPlanOverride[]
  invitations            OrganizationInvitation[]
  activationRequests     SubscriptionActivationRequest[]
  partnerMappings        PartnerCustomerMapping[]
  partnerWebhookEvents   PartnerWebhookEvent[]
  demoData               OrganizationDemoData?

  @@map("organizations")
}

model OrganizationDemoData {
  organizationId String       @id @map("organization_id") @db.Uuid
  loadedAt       DateTime?    @map("loaded_at") @db.Timestamptz(3)
  clearedAt      DateTime?    @map("cleared_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_demo_data")
}

model SubscriptionPlan {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(32)
  name            String   @db.VarChar(80)
  price           Int
  currency        String   @default("INR") @db.Char(3)
  billingInterval String   @default("monthly") @map("billing_interval") @db.VarChar(16)
  trialDays       Int      @default(0) @map("trial_days")
  features        String[] @default([])
  modules         String[] @default(["leads", "contacts", "companies", "deals", "activities", "vendors", "billing-invoicing", "team", "automation", "email", "reports", "audit-logs", "settings"])
  employeeLimit   Int?     @map("employee_limit")
  maxDevicesPerUser Int    @default(1) @map("max_devices_per_user")
  deviceRestrictionEnabled Boolean @default(true) @map("device_restriction_enabled")
  usageLimits     Json     @default("{}") @map("usage_limits")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizationOverrides OrganizationSubscriptionPlanOverride[]

  @@map("subscription_plans")
}

model OrganizationSubscriptionPlanOverride {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  planCode        String       @map("plan_code") @db.VarChar(32)
  name            String       @db.VarChar(80)
  price           Int
  currency        String       @db.Char(3)
  billingInterval String       @map("billing_interval") @db.VarChar(16)
  trialDays       Int          @map("trial_days")
  features        String[]     @default([])
  modules         String[]     @default([])
  employeeLimit   Int?         @map("employee_limit")
  maxDevicesPerUser Int?       @map("max_devices_per_user")
  deviceRestrictionEnabled Boolean? @map("device_restriction_enabled")
  usageLimits     Json         @default("{}") @map("usage_limits")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan @relation(fields: [planCode], references: [code], onDelete: Cascade, onUpdate: Cascade)

  @@unique([organizationId, planCode])
  @@index([planCode])
  @@map("organization_subscription_plan_overrides")
}

model SubscriptionActivationRequest {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  requestedById  String                  @map("requested_by_id") @db.Uuid
  planCode       String                  @map("plan_code") @db.VarChar(32)
  requestType    SubscriptionRequestType @default(ACTIVATION) @map("request_type")
  status         ActivationRequestStatus @default(PENDING)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    User                    @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([organizationId, createdAt])
  @@map("subscription_activation_requests")
}

model PlatformAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  actorEmail String?  @map("actor_email") @db.VarChar(254)
  action     String   @db.VarChar(120)
  targetType String   @map("target_type") @db.VarChar(80)
  targetId   String?  @map("target_id") @db.VarChar(128)
  reason     String?  @db.VarChar(500)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("platform_audit_logs")
}

model Membership {
  id                     String                   @id @default(uuid()) @db.Uuid
  userId                 String                   @map("user_id") @db.Uuid
  organizationId         String                   @map("organization_id") @db.Uuid
  role                   MembershipRole           @default(SALES_REP)
  customRoleId           String?                  @map("custom_role_id") @db.Uuid
  status                 MembershipStatus         @default(ACTIVE)
  enabledModules         String[]                 @default([]) @map("enabled_modules")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole             WorkspaceRole?            @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  leadsOwned             Lead[]                   @relation("LeadOwner")
  leadsCreated           Lead[]                   @relation("LeadCreator")
  leadCallsLogged        LeadCall[]                @relation("LeadCallLogger")
  contactsOwned          Contact[]                @relation("ContactOwner")
  contactsCreated        Contact[]                @relation("ContactCreator")
  companiesOwned         Company[]                @relation("CompanyOwner")
  companiesCreated       Company[]                @relation("CompanyCreator")
  vendorsOwned           Vendor[]                 @relation("VendorOwner")
  vendorsCreated         Vendor[]                 @relation("VendorCreator")
  dealsOwned             Deal[]                   @relation("DealOwner")
  dealsCreated           Deal[]                   @relation("DealCreator")
  activitiesAssigned     Activity[]               @relation("ActivityAssignee")
  activitiesCreated      Activity[]               @relation("ActivityCreator")
  emailsSent             EmailMessage[]           @relation("EmailMessageSender")
  automationRulesCreated AutomationRule[]         @relation("AutomationRuleCreator")
  notificationsReceived  Notification[]           @relation("NotificationRecipient")
  auditLogsAuthored      AuditLog[]               @relation("AuditLogActor")
  billingProductsCreated     BillingProduct[]     @relation("BillingProductCreator")
  billingInvoicesCreated     BillingInvoice[]     @relation("BillingInvoiceCreator")
  billingInvoicesOwned       BillingInvoice[]     @relation("BillingInvoiceOwner")
  billingQuotationsCreated   BillingQuotation[]   @relation("BillingQuotationCreator")
  billingPaymentsCreated     BillingPayment[]     @relation("BillingPaymentCreator")
  billingAuditEventsAuthored BillingAuditEvent[]  @relation("BillingAuditActor")
  subscriptionPayments      SubscriptionPayment[] @relation("SubscriptionPaymentRequester")
  invitationsSent        OrganizationInvitation[] @relation("InvitationSender")

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status, role])
  @@map("memberships")
}

model WorkspaceRole {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  name              String         @db.VarChar(60)
  description       String         @default("") @db.VarChar(200)
  permissionProfile MembershipRole @map("permission_profile")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships       Membership[]

  @@unique([organizationId, name])
  @@index([organizationId, createdAt])
  @@map("workspace_roles")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  deviceHash String?  @map("device_hash") @db.Char(64)
  deviceLabel String? @map("device_label") @db.VarChar(160)
  userAgent String?   @map("user_agent") @db.VarChar(500)
  ipHash String?      @map("ip_hash") @db.Char(64)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([userId, deviceHash, expiresAt])
  @@map("sessions")
}

model GlobalSecuritySettings {
  id Int @id @default(1)
  failedLoginLockoutEnabled Boolean @default(true) @map("failed_login_lockout_enabled")
  maxFailedLoginAttempts Int @default(3) @map("max_failed_login_attempts")
  lockoutDurationMinutes Int @default(10) @map("lockout_duration_minutes")
  sessionLifetimeMinutes Int @default(10080) @map("session_lifetime_minutes")
  deviceRestrictionsEnabled Boolean @default(true) @map("device_restrictions_enabled")
  updatedByUserId String? @map("updated_by_user_id") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("global_security_settings")
}

model EmailToken {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  tokenHash  String            @unique @map("token_hash") @db.Char(64)
  purpose    EmailTokenPurpose
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?         @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("email_tokens")
}

enum ProvisioningStatus {
  RUNNING
  SUCCEEDED
  FAILED

  @@map("provisioning_status")
}

model ProvisioningRequest {
  id                String             @id @default(uuid()) @db.Uuid
  requestId         String             @unique @map("request_id") @db.VarChar(128)
  idempotencyKey    String             @unique @map("idempotency_key") @db.VarChar(200)
  orderId           String             @unique @map("order_id") @db.VarChar(128)
  product           String             @db.VarChar(32)
  status            ProvisioningStatus @default(RUNNING)
  activationEmailSent Boolean           @default(false) @map("activation_email_sent")
  organizationId    String?            @map("organization_id") @db.Uuid
  tenantSlug        String?            @map("tenant_slug") @db.VarChar(63)
  ownerUserId       String?            @map("owner_user_id") @db.Uuid
  planCode          String             @map("plan_code") @db.VarChar(32)
  credentialsEnc    String?            @map("credentials_enc") @db.Text
  partnerId         String?            @map("partner_id") @db.Uuid
  externalCustomerRef String?           @map("external_customer_ref") @db.VarChar(160)
  purchaseType      String?             @map("purchase_type") @db.VarChar(16)
  trialStartedAt    DateTime?           @map("trial_started_at") @db.Timestamptz(3)
  trialEndsAt       DateTime?           @map("trial_ends_at") @db.Timestamptz(3)
  failureCode       String?            @map("failure_code") @db.VarChar(80)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  partner           IntegrationPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("provisioning_requests")
}

model IntegrationPartner {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String                   @db.VarChar(120)
  enabled            Boolean                  @default(true)
  permissions        String[]                 @default(["provision", "customers:read", "subscriptions:write"])
  webhookUrl         String?                  @map("webhook_url") @db.VarChar(2048)
  plansUrl           String?                  @map("plans_url") @db.VarChar(2048)
  webhookSecretEnc   String?                  @map("webhook_secret_enc") @db.Text
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  apiKeys            PartnerApiKey[]
  mappings           PartnerCustomerMapping[]
  provisioningRequests ProvisioningRequest[]
  webhookEvents      PartnerWebhookEvent[]
  trialEligibilities PartnerTrialEligibility[]
  usageLogs          PartnerApiUsageLog[]

  @@map("integration_partners")
}

model PartnerApiKey {
  id           String             @id @default(uuid()) @db.Uuid
  partnerId    String             @map("partner_id") @db.Uuid
  keyPrefix    String             @map("key_prefix") @db.VarChar(24)
  keyHash      String             @unique @map("key_hash") @db.Char(64)
  keySecretEnc String?            @map("key_secret_enc") @db.Text
  permissions  String[]           @default([])
  active       Boolean            @default(true)
  lastUsedAt   DateTime?          @map("last_used_at") @db.Timestamptz(3)
  revokedAt    DateTime?          @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  partner      IntegrationPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  usageLogs    PartnerApiUsageLog[]

  @@index([partnerId, active])
  @@map("partner_api_keys")
}

model PartnerCustomerMapping {
  id                    String             @id @default(uuid()) @db.Uuid
  partnerId             String             @map("partner_id") @db.Uuid
  organizationId        String             @map("organization_id") @db.Uuid
  externalCustomerRef   String             @map("external_customer_ref") @db.VarChar(160)
  externalSubscriptionRef String?           @map("external_subscription_ref") @db.VarChar(160)
  email                 String             @db.VarChar(254)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  partner               IntegrationPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([partnerId, externalCustomerRef])
  @@unique([partnerId, externalSubscriptionRef])
  @@index([email])
  @@map("partner_customer_mappings")
}

model PartnerWebhookEvent {
  id             String             @id @default(uuid()) @db.Uuid
  partnerId      String             @map("partner_id") @db.Uuid
  externalEventId String            @map("external_event_id") @db.VarChar(160)
  eventType      String             @map("event_type") @db.VarChar(48)
  organizationId String?            @map("organization_id") @db.Uuid
  payloadHash    String             @map("payload_hash") @db.Char(64)
  outcome        String             @db.VarChar(24)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  partner        IntegrationPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([partnerId, externalEventId])
  @@index([createdAt])
  @@map("partner_webhook_events")
}

model PartnerTrialEligibility {
  id         String   @id @default(uuid()) @db.Uuid
  emailHash  String   @unique @map("email_hash") @db.Char(64)
  startedAt  DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  partnerId  String   @map("partner_id") @db.Uuid
  partner    IntegrationPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("partner_trial_eligibility")
}

model PartnerApiUsageLog {
  id         String             @id @default(uuid()) @db.Uuid
  partnerId  String             @map("partner_id") @db.Uuid
  apiKeyId   String             @map("api_key_id") @db.Uuid
  operation  String             @db.VarChar(80)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  partner    IntegrationPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  apiKey     PartnerApiKey      @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([apiKeyId, createdAt])
