enum OrganizationStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("organization_status")
}


enum SubscriptionStatus {
  PENDING   @map("pending")
  TRIAL     @map("trial")
  ACTIVE    @map("active")
  EXPIRED   @map("expired")
  CANCELLED @map("cancelled")

  @@map("subscription_status")
}


generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")

  @@map("user_status")
}

enum MembershipRole {
  OWNER         @map("owner")
  ADMIN         @map("admin")
  SALES_MANAGER @map("sales_manager")
  SALES_REP     @map("sales_rep")
  READ_ONLY     @map("read_only")

  @@map("membership_role")
}

enum MembershipStatus {
  ACTIVE  @map("active")
  REVOKED @map("revoked")
  REMOVED @map("removed")

  @@map("membership_status")
}

enum LeadSource {
  WEBSITE  @map("website")
  REFERRAL @map("referral")
  LINKEDIN @map("linkedin")
  OTHER    @map("other")

  @@map("lead_source")
}

enum LeadStatus {
  NEW          @map("new")
  CONTACTED    @map("contacted")
  QUALIFIED    @map("qualified")
  DISQUALIFIED @map("disqualified")

  @@map("lead_status")
}

enum DealStatus {
  OPEN @map("open")
  WON  @map("won")
  LOST @map("lost")

  @@map("deal_status")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(254)
  name         String       @db.VarChar(120)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  status                     UserStatus   @default(ACTIVE)
  emailVerifiedAt            DateTime?    @map("email_verified_at") @db.Timestamptz(3)
  emailVerificationTokenHash String?     @map("email_verification_token_hash") @db.VarChar(64)
  emailVerificationExpiresAt DateTime?    @map("email_verification_expires_at") @db.Timestamptz(3)
  passwordResetTokenHash     String?     @map("password_reset_token_hash") @db.VarChar(64)
  passwordResetExpiresAt    DateTime?    @map("password_reset_expires_at") @db.Timestamptz(3)
  createdAt                  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships          Membership[]
  sessions             Session[]
  refreshTokens        RefreshToken[]
  createdInvitations    Invitation[] @relation("InvitationCreator")

  @@map("users")
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(160)
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships            Membership[]
  invitations            Invitation[]
  subscriptionPlan       String?            @map("subscription_plan") @db.VarChar(32)
  subscriptionStatus     SubscriptionStatus @default(PENDING) @map("subscription_status")
  subscriptionStartedAt  DateTime?           @map("subscription_started_at") @db.Timestamptz(3)
  subscriptionEndsAt     DateTime?           @map("subscription_ends_at") @db.Timestamptz(3)
  billingProvider        String?             @map("billing_provider") @db.VarChar(32)
  razorpaySubscriptionId String?             @map("razorpay_subscription_id") @db.VarChar(128)
  enabledModules        String[]             @default(["leads", "contacts", "companies", "deals", "activities", "team", "automation", "reports"]) @map("enabled_modules")
  leads       Lead[]
  contacts    Contact[]
  companies   Company[]
  pipelines   Pipeline[]
  deals       Deal[]
  activities  Activity[]

  @@map("organizations")
}

model SubscriptionPlan {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(32)
  name            String   @db.VarChar(80)
  price           Int
  currency        String   @default("INR") @db.Char(3)
  billingInterval String   @default("monthly") @map("billing_interval") @db.VarChar(16)
  trialDays       Int      @default(0) @map("trial_days")
  features        String[] @default([])
  employeeLimit   Int?     @map("employee_limit")
  usageLimits     Json     @default("{}") @map("usage_limits")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("subscription_plans")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           MembershipRole   @default(SALES_REP)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadsOwned     Lead[]           @relation("LeadOwner")
  leadsCreated   Lead[]           @relation("LeadCreator")
  contactsOwned  Contact[]        @relation("ContactOwner")
  contactsCreated Contact[]       @relation("ContactCreator")
  activitiesCreated Activity[]     @relation("ActivityCreator")
  activitiesAssigned Activity[]    @relation("ActivityAssignee")
  companiesCreated Company[]      @relation("CompanyCreator")
  companiesOwned Company[]        @relation("CompanyOwner")
  dealsOwned       Deal[]          @relation("DealOwner")
  dealsCreated     Deal[]          @relation("DealCreator")

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status, role])
  @@map("memberships")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthRateLimitBucket {
  keyHash   String   @id @map("key_hash") @db.Char(64)
  count     Int
  resetAt   DateTime @map("reset_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("auth_rate_limit_buckets")
}

model RefreshToken {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash") @db.Char(64)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenHash String?  @map("replaced_by_token_hash") @db.Char(64)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  email           String           @db.VarChar(254)
  role            MembershipRole   @default(SALES_REP)
  tokenHash       String           @unique @map("token_hash") @db.Char(64)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("invitations")
}



model Lead {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String      @db.VarChar(120)
  company        String      @db.VarChar(160)
  source         LeadSource
  status         LeadStatus  @default(NEW)
  ownerUserId    String      @map("owner_user_id") @db.Uuid
  createdByUserId String     @map("created_by_user_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime?   @map("archived_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          Membership  @relation("LeadOwner", fields: [organizationId, ownerUserId], references: [organizationId, userId], onDelete: Restrict)
  creator        Membership  @relation("LeadCreator", fields: [organizationId, createdByUserId], references: [organizationId, userId], onDelete: Restrict)

  @@index([organizationId, archivedAt, createdAt])
  @@index([organizationId, status, archivedAt])
  @@index([organizationId, source, archivedAt])
  @@index([organizationId, ownerUserId, archivedAt])
  @@map("leads")
}

model Contact {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(120)
  email          String       @db.VarChar(254)
  phone          String?      @db.VarChar(40)
  title          String?      @db.VarChar(120)
  company        String?      @db.VarChar(160)
  ownerUserId    String       @map("owner_user_id") @db.Uuid
  createdByUserId String      @map("created_by_user_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          Membership   @relation("ContactOwner", fields: [organizationId, ownerUserId], references: [organizationId, userId], onDelete: Restrict)
  creator        Membership   @relation("ContactCreator", fields: [organizationId, createdByUserId], references: [organizationId, userId], onDelete: Restrict)

  @@unique([organizationId, email])
  @@index([organizationId, archivedAt, createdAt])
  @@index([organizationId, ownerUserId, archivedAt])
  @@map("contacts")
}

model Company {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  name            String       @db.VarChar(160)
  industry        String?      @db.VarChar(120)
  website         String?      @db.VarChar(255)
  phone           String?      @db.VarChar(40)
  ownerUserId     String       @map("owner_user_id") @db.Uuid
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?    @map("archived_at") @db.Timestamptz(3)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           Membership   @relation("CompanyOwner", fields: [organizationId, ownerUserId], references: [organizationId, userId], onDelete: Restrict)
  creator         Membership   @relation("CompanyCreator", fields: [organizationId, createdByUserId], references: [organizationId, userId], onDelete: Restrict)
  deals           Deal[]

  @@unique([organizationId, id])
  @@index([organizationId, archivedAt, createdAt])
  @@index([organizationId, ownerUserId, archivedAt])
  @@map("companies")
}

model Pipeline {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String         @db.VarChar(120)
  isDefault      Boolean        @default(false) @map("is_default")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         PipelineStage[]
  deals          Deal[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, isDefault])
  @@map("pipelines")
}

model PipelineStage {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  pipelineId     String       @map("pipeline_id") @db.Uuid
  name           String       @db.VarChar(80)
  position       Int
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  pipeline       Pipeline     @relation(fields: [organizationId, pipelineId], references: [organizationId, id], onDelete: Cascade)
  deals          Deal[]

  @@unique([organizationId, pipelineId, id])
  @@unique([organizationId, pipelineId, name])
  @@unique([organizationId, pipelineId, position])
  @@map("pipeline_stages")
}

model Deal {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  name            String       @db.VarChar(160)
  value           Decimal      @default(0) @db.Decimal(12, 2)
  closeDate       DateTime?    @map("close_date") @db.Date
  status          DealStatus   @default(OPEN)
  companyId       String?      @map("company_id") @db.Uuid
  pipelineId      String       @map("pipeline_id") @db.Uuid
  stageId         String       @map("stage_id") @db.Uuid
  ownerUserId     String       @map("owner_user_id") @db.Uuid
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?    @map("archived_at") @db.Timestamptz(3)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company         Company?     @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  pipeline        Pipeline     @relation(fields: [organizationId, pipelineId], references: [organizationId, id], onDelete: Restrict)
  stage           PipelineStage @relation(fields: [organizationId, pipelineId, stageId], references: [organizationId, pipelineId, id], onDelete: Restrict)
  owner           Membership   @relation("DealOwner", fields: [organizationId, ownerUserId], references: [organizationId, userId], onDelete: Restrict)
  creator         Membership   @relation("DealCreator", fields: [organizationId, createdByUserId], references: [organizationId, userId], onDelete: Restrict)

  @@index([organizationId, archivedAt, createdAt])
  @@index([organizationId, pipelineId, stageId, archivedAt])
  @@index([organizationId, ownerUserId, archivedAt])
  @@map("deals")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorEmail     String?  @map("actor_email") @db.VarChar(254)
  action         String   @db.VarChar(120)
  targetType     String   @map("target_type") @db.VarChar(80)
  targetId       String?  @map("target_id") @db.VarChar(128)
  reason         String?  @db.VarChar(500)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}


enum ActivityType {
  TASK    @map("task")
  CALL    @map("call")
  MEETING @map("meeting")
  NOTE    @map("note")
  EMAIL   @map("email")

  @@map("activity_type")
}

enum ActivityStatus {
  OPEN        @map("open")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  CANCELLED   @map("cancelled")

  @@map("activity_status")
}

enum ActivityPriority {
  LOW    @map("low")
  NORMAL @map("normal")
  HIGH   @map("high")

  @@map("activity_priority")
}

model Activity {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  type            ActivityType      @default(TASK)
  title           String            @db.VarChar(160)
  description     String?           @db.Text
  status          ActivityStatus    @default(OPEN)
  priority        ActivityPriority  @default(NORMAL)
  dueAt           DateTime?         @map("due_at") @db.Timestamptz(3)
  completedAt     DateTime?         @map("completed_at") @db.Timestamptz(3)
  assignedToUserId String?          @map("assigned_to_user_id") @db.Uuid
  relatedToType   String?           @map("related_to_type") @db.VarChar(32)
  relatedToId     String?           @map("related_to_id") @db.Uuid
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator         Membership        @relation("ActivityCreator", fields: [organizationId, createdByUserId], references: [organizationId, userId], onDelete: Restrict)
  assignee        Membership?       @relation("ActivityAssignee", fields: [organizationId, assignedToUserId], references: [organizationId, userId], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, assignedToUserId, status])
  @@map("activities")
}
