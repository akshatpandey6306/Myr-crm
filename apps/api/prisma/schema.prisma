  paymentStatus          BillingInvoicePaymentStatus @default(UNPAID) @map("payment_status")
  subtotal               Decimal                     @default(0) @db.Decimal(18, 4)
  discountAmount         Decimal                     @default(0) @map("discount_amount") @db.Decimal(18, 4)
  discountType           BillingDiscountType         @default(FIXED) @map("discount_type")
  discountValue          Decimal                     @default(0) @map("discount_value") @db.Decimal(18, 4)
  taxAmount              Decimal                     @default(0) @map("tax_amount") @db.Decimal(18, 4)
  additionalCharges      Decimal                     @default(0) @map("additional_charges") @db.Decimal(18, 4)
  shippingAmount         Decimal                     @default(0) @map("shipping_amount") @db.Decimal(18, 4)
  roundOff               Decimal                     @default(0) @map("round_off") @db.Decimal(18, 4)
  grandTotal             Decimal                     @default(0) @db.Decimal(18, 4)
  amountPaid             Decimal                     @default(0) @map("amount_paid") @db.Decimal(18, 4)
  balanceDue             Decimal                     @default(0) @map("balance_due") @db.Decimal(18, 4)
  notes                  String?                     @db.Text
  internalNotes          String?                     @map("internal_notes") @db.Text
  terms                  String?                     @db.Text
  issuedAt               DateTime?                   @map("issued_at") @db.Timestamptz(3)
  cancelledAt            DateTime?                   @map("cancelled_at") @db.Timestamptz(3)
  createdByUserId        String                      @map("created_by_user_id") @db.Uuid
  ownerUserId            String                      @map("owner_user_id") @db.Uuid
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization           Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact                Contact?                    @relation("BillingInvoiceContact", fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  company                Company?                    @relation("BillingInvoiceCompany", fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  creator                Membership                  @relation("BillingInvoiceCreator", fields: [organizationId, createdByUserId], references: [organizationId, userId], onDelete: Restrict)
  owner                  Membership                  @relation("BillingInvoiceOwner", fields: [organizationId, ownerUserId], references: [organizationId, userId], onDelete: Restrict)
  items                  BillingInvoiceItem[]
  payments               BillingPayment[]
  convertedFromQuotation BillingQuotation?           @relation("QuotationConversion")

  @@unique([organizationId, id])
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, invoiceDate])
  @@index([organizationId, dueDate, status])
  @@index([organizationId, customerName])
  @@index([organizationId, ownerUserId, createdAt])
  @@map("billing_invoices")
}

model BillingInvoiceItem {
  id                        String              @id @default(uuid()) @db.Uuid
  organizationId            String              @map("organization_id") @db.Uuid
  invoiceId                 String              @map("invoice_id") @db.Uuid
  productId                 String?             @map("product_id") @db.Uuid
  itemName                  String              @map("item_name") @db.VarChar(160)
  description               String?             @db.Text
  sku                       String?             @db.VarChar(64)
  hsnSacCode                String?             @map("hsn_sac_code") @db.VarChar(32)
  quantity                  Decimal             @db.Decimal(18, 4)
  unit                      String              @default("unit") @db.VarChar(24)
  unitPrice                 Decimal             @map("unit_price") @db.Decimal(18, 4)
  discountAmount            Decimal             @default(0) @map("discount_amount") @db.Decimal(18, 4)
  discountType              BillingDiscountType @default(FIXED) @map("discount_type")
  discountValue             Decimal             @default(0) @map("discount_value") @db.Decimal(18, 4)
  invoiceDiscountAllocation Decimal             @default(0) @map("invoice_discount_allocation") @db.Decimal(18, 4)
  taxRate                   Decimal             @default(0) @map("tax_rate") @db.Decimal(7, 4)
  taxAmount                 Decimal             @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal                 Decimal             @map("line_total") @db.Decimal(18, 4)
  position                  Int                 @default(0)
  organization              Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice                   BillingInvoice      @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)
  product                   BillingProduct?     @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, invoiceId, position])
  @@map("billing_invoice_items")
}

model BillingQuotation {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @map("organization_id") @db.Uuid
  quotationNumber    String?                @map("quotation_number") @db.VarChar(40)
  customerType       BillingCustomerType    @map("customer_type")
  contactId          String?                @map("contact_id") @db.Uuid
  companyId          String?                @map("company_id") @db.Uuid
  customerName       String                 @map("customer_name") @db.VarChar(160)
  customerEmail      String?                @map("customer_email") @db.VarChar(254)
  customerPhone      String?                @map("customer_phone") @db.VarChar(40)
  billingAddress     String?                @map("billing_address") @db.Text
  shippingAddress    String?                @map("shipping_address") @db.Text
  validUntil         DateTime?              @map("valid_until") @db.Date
  currency           String                 @db.Char(3)
  status             BillingQuotationStatus @default(DRAFT)
  subtotal           Decimal                @default(0) @db.Decimal(18, 4)
  discountAmount     Decimal                @default(0) @map("discount_amount") @db.Decimal(18, 4)
  discountType       BillingDiscountType    @default(FIXED) @map("discount_type")
  discountValue      Decimal                @default(0) @map("discount_value") @db.Decimal(18, 4)
  taxAmount          Decimal                @default(0) @map("tax_amount") @db.Decimal(18, 4)
  grandTotal         Decimal                @default(0) @db.Decimal(18, 4)
  terms              String?                @db.Text
  notes              String?                @db.Text
  convertedInvoiceId String?                @map("converted_invoice_id") @db.Uuid
  createdByUserId    String                 @map("created_by_user_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact            Contact?               @relation("BillingQuotationContact", fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  company            Company?               @relation("BillingQuotationCompany", fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  creator            Membership             @relation("BillingQuotationCreator", fields: [organizationId, createdByUserId], references: [organizationId, userId], onDelete: Restrict)
  items              BillingQuotationItem[]
  convertedInvoice   BillingInvoice?        @relation("QuotationConversion", fields: [organizationId, convertedInvoiceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, quotationNumber])
  @@unique([organizationId, convertedInvoiceId])
  @@index([organizationId, status, createdAt])
  @@map("billing_quotations")
}

model BillingQuotationItem {
  id                        String              @id @default(uuid()) @db.Uuid
  organizationId            String              @map("organization_id") @db.Uuid
  quotationId               String              @map("quotation_id") @db.Uuid
  productId                 String?             @db.Uuid @map("product_id")
  itemName                  String              @map("item_name") @db.VarChar(160)
  description               String?             @db.Text
  sku                       String?             @db.VarChar(64)
  hsnSacCode                String?             @map("hsn_sac_code") @db.VarChar(32)
  quantity                  Decimal             @db.Decimal(18, 4)
  unit                      String              @default("unit") @db.VarChar(24)
  unitPrice                 Decimal             @map("unit_price") @db.Decimal(18, 4)
  discountAmount            Decimal             @default(0) @map("discount_amount") @db.Decimal(18, 4)
  discountType              BillingDiscountType @default(FIXED) @map("discount_type")
  discountValue             Decimal             @default(0) @map("discount_value") @db.Decimal(18, 4)
  invoiceDiscountAllocation Decimal             @default(0) @map("invoice_discount_allocation") @db.Decimal(18, 4)
  taxRate                   Decimal             @default(0) @map("tax_rate") @db.Decimal(7, 4)
  taxAmount                 Decimal             @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal                 Decimal             @map("line_total") @db.Decimal(18, 4)
  position                  Int                 @default(0)
  organization              Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation                 BillingQuotation    @relation(fields: [organizationId, quotationId], references: [organizationId, id], onDelete: Cascade)
  product                   BillingProduct?     @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, quotationId, position])
  @@map("billing_quotation_items")
}

model BillingPayment {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  invoiceId            String               @map("invoice_id") @db.Uuid
  paymentNumber        String               @map("payment_number") @db.VarChar(40)
  amount               Decimal              @db.Decimal(18, 4)
  paymentDate          DateTime             @map("payment_date") @db.Timestamptz(3)
  method               BillingPaymentMethod
  transactionReference String?              @map("transaction_reference") @db.VarChar(120)
  idempotencyKey       String?              @db.VarChar(128) @map("idempotency_key")
  notes                String?              @db.Text
  createdByUserId      String               @map("created_by_user_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice              BillingInvoice       @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)
  creator              Membership           @relation("BillingPaymentCreator", fields: [organizationId, createdByUserId], references: [organizationId, userId], onDelete: Restrict)
  receipt              BillingReceipt?

  @@unique([organizationId, id])
  @@unique([organizationId, paymentNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, invoiceId, paymentDate])
  @@index([organizationId, paymentDate])
  @@map("billing_payments")
}

model BillingReceipt {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  paymentId            String               @map("payment_id") @db.Uuid
  receiptNumber        String               @map("receipt_number") @db.VarChar(40)
  customerName         String               @map("customer_name") @db.VarChar(160)
  invoiceNumber        String               @map("invoice_number") @db.VarChar(40)
  amount               Decimal              @db.Decimal(18, 4)
  paymentDate          DateTime             @map("payment_date") @db.Timestamptz(3)
  paymentMethod        BillingPaymentMethod @map("payment_method")
  transactionReference String?              @map("transaction_reference") @db.VarChar(120)
  previousBalance      Decimal              @map("previous_balance") @db.Decimal(18, 4)
  remainingBalance     Decimal              @map("remaining_balance") @db.Decimal(18, 4)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment              BillingPayment       @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, paymentId])
  @@unique([organizationId, receiptNumber])
  @@index([organizationId, createdAt])
  @@map("billing_receipts")
}

model BillingAuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorUserId    String       @map("actor_user_id") @db.Uuid
  resourceType   String       @map("resource_type") @db.VarChar(48)
  resourceId     String       @map("resource_id") @db.Uuid
  action         String       @db.VarChar(48)
  details        Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          Membership   @relation("BillingAuditActor", fields: [organizationId, actorUserId], references: [organizationId, userId], onDelete: Restrict)

  @@index([organizationId, resourceType, resourceId, createdAt])
  @@map("billing_audit_events")
}

model SubscriptionPayment {
  id                    String                   @id @default(uuid()) @db.Uuid
  organizationId        String                   @map("organization_id") @db.Uuid
  requestedByUserId     String                   @map("requested_by_user_id") @db.Uuid
  planCode              String                   @map("plan_code") @db.VarChar(32)
  productInfo           String                   @map("product_info") @db.VarChar(120)
  paymentType           SubscriptionPaymentType @map("payment_type")
  transactionId         String                   @unique @map("transaction_id") @db.VarChar(40)
  amount                Decimal                  @db.Decimal(12, 2)
  currency              String                   @default("INR") @db.Char(3)
  status                SubscriptionPaymentStatus @default(PENDING)
  payuId                String?                  @map("payu_id") @db.VarChar(64)
  bankReference         String?                  @map("bank_reference") @db.VarChar(120)
  failureReason         String?                  @map("failure_reason") @db.VarChar(500)
  renewalBaseEndsAt     DateTime?                @map("renewal_base_ends_at") @db.Timestamptz(3)
  verifiedAt            DateTime?                @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy           Membership               @relation("SubscriptionPaymentRequester", fields: [organizationId, requestedByUserId], references: [organizationId, userId], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, createdAt])
  @@map("subscription_payments")
}
