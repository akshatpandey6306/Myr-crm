

# Next.js server → NestJS API. Browser requests use the same-origin /api/v1 proxy.
API_PROXY_URL=http://localhost:4000/api/v1
WEB_ORIGIN=http://localhost:3000

# NestJS API
PORT=4000
# Set to the exact number of trusted reverse-proxy hops; ensure the API is not
# directly reachable from untrusted clients when forwarding client IPs.
TRUST_PROXY_HOPS=0

# SMTP for verification, password reset, invitations, and CRM email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DATABASE_URL=postgresql://myrcrm:myrcrm@localhost:5432/myrcrm?schema=public
