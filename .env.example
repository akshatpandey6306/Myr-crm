

# Next.js server → NestJS API. Browser requests use the same-origin /api/v1 proxy.
API_PROXY_URL=http://localhost:4000/api/v1
WEB_ORIGIN=http://localhost:3000
PLATFORM_ADMIN_EMAIL=admin@myrcrm.local

# Private central-commerce backend → CRM provisioning API. Use a long random
# value, store it in a secret manager, and configure the same value centrally.
CRM_PROVISIONING_TOKEN=

# Partner integrations: provide 32 random bytes as 64 hex characters.
# This key encrypts partner webhook signing secrets and returned provisioning credentials.
PARTNER_SECRET_ENCRYPTION_KEY=

# SMTP delivery for workspace-owner signup OTPs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public self-service registration is disabled; use the platform provisioning flow.
CRM_SELF_SIGNUP_ENABLED=false

# PayU Hosted Checkout. Keep the merchant salt server-only and out of NEXT_PUBLIC_*.
# PAYU_MODE is the canonical setting; PAYU_ENV is accepted as a compatibility alias.
PAYU_MODE=production
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# Optional test-only override: set to 1.00 to exercise a one-rupee trial in sandbox.
# PAYU_TEST_TRIAL_AMOUNT=1.00
# Must be a publicly reachable HTTPS API URL for PayU/browser callbacks (localhost
# is suitable only for local hash/unit checks and cannot complete a real sandbox flow).
PAYU_CALLBACK_URL=https://api.example.com/api/v1/billing/payu/return

# NestJS API
PORT=4000
# Set to the exact number of trusted reverse-proxy hops; ensure the API is not
# directly reachable from untrusted clients when forwarding client IPs.
TRUST_PROXY_HOPS=0

DATABASE_URL=
