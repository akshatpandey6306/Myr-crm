

# Next.js server → NestJS API. Browser requests use the same-origin /api/v1 proxy.
API_PROXY_URL=http://localhost:4000/api/v1
WEB_ORIGIN=http://localhost:3000
EMAIL_API_KEY=
EMAIL_FROM=Myr CRM <noreply@example.com>
PLATFORM_ADMIN_EMAILS=
# Local-only no-charge trial mode; the API refuses to enable this in production.
BILLING_TEST_MODE=true

# NestJS API
PORT=4000
DATABASE_URL=postgresql://myrcrm:myrcrm@localhost:5432/myrcrm?schema=public
