{
  "name": "myr-crm",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:web": "next dev",
    "build": "next build",
    "start": "node scripts/start-all.mjs",
    "start:web": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:dev": "npm run dev --workspace @myr-crm/api",
    "api:build": "npm run build --workspace @myr-crm/api",
    "api:typecheck": "npm run typecheck --workspace @myr-crm/api",
    "api:test": "npm run test --workspace @myr-crm/api",
    "db:generate": "npm run db:generate --workspace @myr-crm/api",
    "db:migrate": "npm run db:migrate --workspace @myr-crm/api",
    "db:deploy": "npm run db:deploy --workspace @myr-crm/api",
    "db:seed": "npm run db:seed --workspace @myr-crm/api"
  },
  "dependencies": {
    "@next/swc-wasm-nodejs": "^16.4.6",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^30.1.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "multer": "2.5.0",
    "@prisma/config": {
      "effect": "3.22.1"
    }
  }
}
