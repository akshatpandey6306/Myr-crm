{
  "name": "myr-crm",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "api:dev": "npm run dev --workspace @myr-crm/api",
    "api:build": "npm run build --workspace @myr-crm/api",
    "api:typecheck": "npm run typecheck --workspace @myr-crm/api",
    "api:test": "npm run test --workspace @myr-crm/api",
    "db:generate": "npm run db:generate --workspace @myr-crm/api",
    "db:migrate": "npm run db:migrate --workspace @myr-crm/api",
    "db:deploy": "npm run db:deploy --workspace @myr-crm/api",
    "db:seed": "npm run db:seed --workspace @myr-crm/api"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
